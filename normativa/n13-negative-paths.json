      "id": "page-margins-right",
      "family": "final-pdf-geometry",
      "fixture": "tests/normativa/textual-oracle-page-margins.tex",
      "positive_gate": [
        "sh",
        "tests/v2-page-margins-evidence-check.sh"
      ],
      "mutation": {
        "kind": "replace_once",
        "anchor": "\\textual\n\n\\ufctextareaframe",
        "content": "\\textual\n\\newgeometry{twoside=true,inner=3cm,outer=4cm,top=3cm,bottom=2cm}\n\n\\ufctextareaframe"
      },
      "compile": {
        "engine": "pdflatex",
        "passes": 2
      },
      "oracle": [
        "python3",
        "tests/checks/normative_page_margins.py",
        "{pdf}",
        "--json",
        "{evidence_json}"
      ],
      "expected_rule_id": "margin.recto.right",
      "expected_signature": "N7-EVIDENCE rule=margin.recto.right status=FAIL"
    },
    {
