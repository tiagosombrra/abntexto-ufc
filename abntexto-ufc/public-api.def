\ProvidesFile{abntexto-ufc/public-api.def}[2026/08/29 UFC canonical public API]

% Canonical English setup keys forward to the certified Portuguese v2.x behavior.
% Portuguese keys remain supported compatibility surfaces throughout v2.x.
\ExplSyntaxOn

\keys_define:nn { ufc }
  {
    type .choice:,
    type / undergraduate-capstone .meta:n = { tipo = tccgraduacao },
    type / specialization-capstone .meta:n = { tipo = tccespecializacao },
    type / masters-thesis .meta:n = { tipo = dissertacao },
    type / doctoral-thesis .meta:n = { tipo = tese },
    type / research-project .meta:n = { tipo = projeto },
    type / anonymized-research-project .meta:n = { tipo = projetoanonimizado },

    print-mode .choice:,
    print-mode / single-sided .meta:n = { impressao = anverso },
    print-mode / double-sided .meta:n = { impressao = frente-verso },

    cover .choice:,
    cover / auto .meta:n = { capa = auto },
    cover / true .meta:n = { capa = sim },
    cover / false .meta:n = { capa = nao },

    catalog-card .choice:,
    catalog-card / true .meta:n = { ficha-catalografica = sim },
    catalog-card / false .meta:n = { ficha-catalografica = nao },

    coat-of-arms .choice:,
    coat-of-arms / true .meta:n = { brasao = sim },
    coat-of-arms / false .meta:n = { brasao = nao },

    advisor-feminine-label .choice:,
    advisor-feminine-label / true .meta:n = { orientador-feminino = sim },
    advisor-feminine-label / false .meta:n = { orientador-feminino = nao },

    coadvisor-feminine-label .choice:,
    coadvisor-feminine-label / true .meta:n = { coorientador-feminino = sim },
    coadvisor-feminine-label / false .meta:n = { coorientador-feminino = nao },

    font .choice:,
    font / times .meta:n = { fonte = times },
    font / arial .meta:n = { fonte = arial },

    strict-font .choice:,
    strict-font / true .meta:n = { fonte-estrita = sim },
    strict-font / false .meta:n = { fonte-estrita = nao },

    tables .choice:,
    tables / native .meta:n = { tabelas = nativo },
    tables / tabularray .meta:n = { tabelas = tabularray },

    code .choice:,
    code / none .meta:n = { codigo = nenhum },
    code / listings .meta:n = { codigo = listings },
    code / minted .meta:n = { codigo = minted },

    algorithms .choice:,
    algorithms / none .meta:n = { algoritmos = nenhum },
    algorithms / algpseudocodex .meta:n = { algoritmos = algpseudocodex },

    glossary .choice:,
    glossary / none .meta:n = { glossario = nenhum },
    glossary / glossaries .meta:n = { glossario = glossaries },

    index .choice:,
    index / none .meta:n = { indice = nenhum },
    index / imakeidx .meta:n = { indice = imakeidx },

    institution .meta:n = { ies = {#1} },
    institution-acronym .meta:n = { sigla = {#1} },
    center .meta:n = { centro = {#1} },
    department .meta:n = { departamento = {#1} },
    undergraduate-program .meta:n = { curso-graduacao = {#1} },
    undergraduate-degree .meta:n = { habilitacao = {#1} },
    specialization-program .meta:n = { curso-especializacao = {#1} },
    masters-graduate-program .meta:n = { programa-mestrado = {#1} },
    masters-program .meta:n = { nome-mestrado = {#1} },
    masters-degree-field .meta:n = { titulo-mestre = {#1} },
    masters-concentration .meta:n = { area-mestrado = {#1} },
    doctoral-graduate-program .meta:n = { programa-doutorado = {#1} },
    doctoral-program .meta:n = { nome-doutorado = {#1} },
    doctoral-degree-field .meta:n = { titulo-doutor = {#1} },
    doctoral-concentration .meta:n = { area-doutorado = {#1} },
    project-program .meta:n = { programa-projeto = {#1} },
    project-type .meta:n = { tipo-projeto = {#1} },
    submission-entity .meta:n = { entidade-submissao = {#1} },
    project-nature-statement .meta:n = { natureza-projeto = {#1} },
    project-identifier .meta:n = { identificador-projeto = {#1} },
    author .meta:n = { autor = {#1} },
    title .meta:n = { titulo = {#1} },
    subtitle .meta:n = { subtitulo = {#1} },
    title-variant .meta:n = { variacao-titulo = {#1} },
    year .meta:n = { ano = {#1} },
    location .meta:n = { local = {#1} },
    approval-date .meta:n = { data-aprovacao = {#1} },
    advisor .meta:n = { orientador = {#1} },
    advisor-institution .meta:n = { orientador-ies = {#1} },
    advisor-unit .meta:n = { orientador-unidade = {#1} },
    coadvisor .meta:n = { coorientador = {#1} },
    coadvisor-institution .meta:n = { coorientador-ies = {#1} },
    coadvisor-unit .meta:n = { coorientador-unidade = {#1} },
    epigraph-author .meta:n = { autor-epigrafe = {#1} },
    examiner-2 .meta:n = { banca-2 = {#1} },
    examiner-2-unit .meta:n = { banca-2-unidade = {#1} },
    examiner-2-institution .meta:n = { banca-2-ies = {#1} },
    examiner-3 .meta:n = { banca-3 = {#1} },
    examiner-3-unit .meta:n = { banca-3-unidade = {#1} },
    examiner-3-institution .meta:n = { banca-3-ies = {#1} },
    examiner-4 .meta:n = { banca-4 = {#1} },
    examiner-4-unit .meta:n = { banca-4-unidade = {#1} },
    examiner-4-institution .meta:n = { banca-4-ies = {#1} },
    examiner-5 .meta:n = { banca-5 = {#1} },
    examiner-5-unit .meta:n = { banca-5-unidade = {#1} },
    examiner-5-institution .meta:n = { banca-5-ies = {#1} },
    examiner-6 .meta:n = { banca-6 = {#1} },
    examiner-6-unit .meta:n = { banca-6-unidade = {#1} },
    examiner-6-institution .meta:n = { banca-6-ies = {#1} },
    coat-of-arms-file .meta:n = { brasao-arquivo = {#1} },
    initial-page .meta:n = { pagina-inicial = {#1} }
  }

% B2R-B3 canonical commands forward to the certified v2.x public behavior.
% The legacy commands remain the behavior owners during v2.x.
\NewDocumentCommand \ufcPrintCover { }
  { \imprimircapa }

\NewDocumentCommand \ufcPrintTitlePage { O{} }
  { \imprimirfolhaderosto[#1] }

\NewDocumentCommand \ufcPrintApprovalPage { }
  { \imprimirfolhadeaprovacao }

\NewDocumentCommand \ufcPrintCatalogCard { m }
  { \imprimirfichacatalografica{#1} }

\NewDocumentCommand \ufcPrintDedication { m }
  { \imprimirdedicatoria{#1} }

\NewDocumentCommand \ufcPrintAcknowledgments { m }
  { \imprimiragradecimentos{#1} }

\NewDocumentCommand \ufcPrintEpigraph { O{short} m }
  {
    \str_case:nnF {#1}
      {
        {short} { \imprimirepigrafe[curta]{#2} }
        {long}  { \imprimirepigrafe[longa]{#2} }
      }
      {
        \ClassError{abntexto-ufc}
          {Invalid~canonical~epigraph~type~'#1'}
          {Use~\string\ufcPrintEpigraph[short]~or~\string\ufcPrintEpigraph[long].}
      }
  }

\NewDocumentCommand \ufcPrintErrata { m }
  { \imprimirerrata{#1} }

\NewDocumentCommand \ufcSummaryKeywords { m }
  { \palavraschave{#1} }

\NewDocumentCommand \ufcPrintSummary { m }
  { \imprimirresumo{#1} }

\NewDocumentCommand \ufcPrintAbstract { m }
  { \imprimirabstract{#1} }

\NewDocumentCommand \ufcPrintListOfIllustrations { }
  { \imprimirlistadeilustracoes }

\NewDocumentCommand \ufcPrintListOfFigures { }
  { \imprimirlistadefiguras }

\NewDocumentCommand \ufcPrintListOfTables { }
  { \imprimirlistadetabelas }

\NewDocumentCommand \ufcPrintListOfTextTables { }
  { \imprimirlistadequadros }

\NewDocumentCommand \ufcPrintListOfCharts { }
  { \imprimirlistadegraficos }

\NewDocumentCommand \ufcPrintListOfCodeListings { }
  { \imprimirlistadecodigos }

\NewDocumentCommand \ufcPrintListOfAlgorithms { }
  { \imprimirlistadealgoritmos }

\NewDocumentCommand \ufcPrintListOfAbbreviationsAndAcronyms { m }
  { \imprimirlistadeabreviaturasesiglas{#1} }

\NewDocumentCommand \ufcPrintListOfSymbols { m }
  { \imprimirlistadesimbolos{#1} }

\NewDocumentCommand \ufcListEntry { m m }
  { \ufclistaentrada{#1}{#2} }

\NewDocumentCommand \ufcPrintTableOfContents { }
  { \imprimirsumario }

\NewDocumentCommand \ufcSource { m }
  { \ufcfonte{#1} }

\NewDocumentCommand \ufcNote { m }
  { \ufcnota{#1} }

\NewDocumentCommand \ufcAddBibliographyResource { m }
  { \ufcbibliografia{#1} }

\NewDocumentCommand \ufcPrintReferences { }
  { \imprimirreferencias }

\NewDocumentCommand \ufcPrintGlossary { }
  { \imprimirglossario }

\NewDocumentCommand \ufcPrintIndex { }
  { \imprimirindice }

% Canonical environment aliases preserve the certified legacy environment bodies.
\NewDocumentEnvironment { ufclettereditems } { }
  { \begin{ufcalineas} }
  { \end{ufcalineas} }

\NewDocumentEnvironment { ufcdashedsubitems } { }
  { \begin{ufcsubalineas} }
  { \end{ufcsubalineas} }

\NewDocumentEnvironment { ufcdefinitionlist } { O{3cm} }
  { \begin{ufclistadefinicoes}[#1] }
  { \end{ufclistadefinicoes} }

\NewDocumentEnvironment { ufcobject } { O{\placepos} }
  { \begin{ufcobjeto}[#1] }
  { \end{ufcobjeto} }

% Optional-module aliases are activated only when their certified legacy surface exists.
\cs_new_protected:Npn \ufc_public_api_setup_optional_aliases:
  {
    \cs_if_exist:NT \ufcinputlisting
      {
        \NewDocumentCommand \ufcInputListing { O{} m }
          { \ufcinputlisting[##1]{##2} }
      }

    \cs_if_exist:NT \ufcinputminted
      {
        \NewDocumentCommand \ufcInputMinted { O{\placepos} O{} m m }
          { \ufcinputminted[##1][##2]{##3}{##4} }
      }

    \cs_if_exist:cT { ufcalgoritmo }
      {
        \NewDocumentEnvironment { ufcalgorithm } { O{\placepos} O{1} }
          { \begin{ufcalgoritmo}[##1][##2] }
          { \end{ufcalgoritmo} }
      }
  }

\AtBeginDocument{\ufc_public_api_setup_optional_aliases:}

\ExplSyntaxOff

\endinput
