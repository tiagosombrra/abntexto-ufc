\ProvidesFile{abntexto-ufc/public-api.def}[2026/08/29 UFC canonical public API]

% Canonical English setup keys forward to the certified Portuguese v2.x behavior.
% Portuguese keys remain supported compatibility surfaces throughout v2.x.
\ExplSyntaxOn

\keys_define:nn { ufc }
  {
    type .choice:,
    type / undergraduate-capstone .meta:n = { tipo = tccgraduacao },
    type / specialization-capstone .meta:n = { tipo = tccespecializacao },
    type / masters-thesis .meta:n = { tipo = dissertacao },
