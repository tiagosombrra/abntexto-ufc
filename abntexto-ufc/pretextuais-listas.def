\ProvidesFile{abntexto-ufc/pretextuais-listas.def}[2026/08/27 UFC aligned definition lists]

% Keep the semantic description-list API and page-breaking behavior.  The
% multiline/parleft combination places each label in a top-aligned paragraph
% box, matching the first line of the corresponding definition.
\RenewDocumentEnvironment{ufclistadefinicoes}{O{3cm}}
  {%
    \begin{description}[
      style=multiline,
      align=parleft,
      leftmargin=#1,
      labelwidth=\dimexpr#1-.3cm\relax,
      labelsep=.3cm,
      font=\normalfont,
      itemsep=0pt,
      parsep=0pt,
      partopsep=0pt,
      topsep=0pt
    ]%
  }
  {\end{description}}

\RenewDocumentCommand\ufclistaentrada{m m}
  {\item[#1] #2}

\endinput
