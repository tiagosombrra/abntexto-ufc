\ProvidesFile{abntexto-ufc/pretextuais-listas.def}[2026/08/27 UFC aligned definition lists]

\RequirePackage{array}
\RequirePackage{longtable}

% Abbreviation/acronym and symbol lists are semantic two-column rows.
% A description list boxes the label independently and can shift its baseline
% relative to the definition.  Use a breakable table so both cells share the
% same row baseline while preserving long-list page breaks.
\RenewDocumentEnvironment{ufclistadefinicoes}{O{3cm}}
  {%
    \par
    \setlength{\LTleft}{0pt}%
    \setlength{\LTright}{0pt}%
    \setlength{\LTpre}{0pt}%
    \setlength{\LTpost}{0pt}%
    \begin{longtable}{%
      @{}%
      >{\RaggedRight\arraybackslash}p{#1}%
      @{\hspace{.3cm}}%
      >{\RaggedRight\arraybackslash}p{\dimexpr\linewidth-#1-.3cm\relax}%
      @{}%
    }%
  }
  {%
    \end{longtable}%
    \par
  }

\RenewDocumentCommand\ufclistaentrada{m m}
  {\strut #1 & \strut #2 \tabularnewline}

\endinput
