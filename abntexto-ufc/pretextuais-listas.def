\ProvidesFile{abntexto-ufc/pretextuais-listas.def}[2026/08/27 UFC aligned definition lists]

% Keep the semantic description-list API and page-breaking behavior.  With
% description lists, enumitem applies label alignment on the boxed standard
% style; parleft then gives the label a top-aligned paragraph box so its first
% baseline matches the corresponding definition line.
\RenewDocumentEnvironment{ufclistadefinicoes}{O{3cm}}
  {%
    \begin{description}[
      style=standard,
      align=parleft,
      leftmargin=#1,
      labelwidth=\dimexpr#1-.3cm\relax,
      labelsep=.3cm,
      font=\normalfont,
      itemsep=0pt,
      parsep=0pt,
      partopsep=0pt,
      topsep=0pt
    ]%
  }
  {\end{description}}

\RenewDocumentCommand\ufclistaentrada{m m}
  {\item[#1] #2}

\endinput
