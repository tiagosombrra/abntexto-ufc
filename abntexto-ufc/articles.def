\ProvidesFile{abntexto-ufc/articles.def}[2026/08/29 UFC scientific article profile]

% NBR 6022:2018 + compatible UFC scientific-article requirements.
% Source-backed contract: normativa/coverage-rules-article.json.
\ExplSyntaxOn

% B2B activates only the setup values reserved during B2R. No new setup key,
% public command, environment, or extension hook is introduced here.
\keys_define:nn { ufc }
  {
    tipo / artigo .code:n =
      {
        \tl_gset:Nn \g_ufc_document_type_tl { artigo }
        \bool_gset_false:N \g_ufc_coat_of_arms_bool
      },
    type / article .meta:n = { tipo = artigo }
  }

\prg_new_conditional:Npnn \ufc_article_if: { T, F, TF }
  {
    \str_if_eq:VnTF \g_ufc_document_type_tl { artigo }
      { \prg_return_true: }
      { \prg_return_false: }
  }

% Snapshot the kernel's default date value without patching or redefining
% \date. A later explicit \date{...} call changes \@date's meaning, which can
% then be detected when the article title block is emitted.
\cs_new_eq:Nc \ufc_article_default_date: {@date}

% The original textual switch is a plain class macro, so it is safe to snapshot
% as the page-style/layout behavior used by article pre-textual content.
\cs_new_eq:NN \ufc_article_base_textual: \textual

\cs_new_protected:Npn \ufc_article_require_metadata:n #1
  {
    \ufc_meta_if_blank:nT {#1}
      {
        \ClassError{abntexto-ufc}
          {Required~article~metadata~'#1'~is~empty}
          {Set~the~corresponding~field~before~printing~the~article~front~matter.}
      }
  }

\cs_new_protected:Npn \ufc_article_require_submission_date:
  {
    \cs_if_eq:NcTF \ufc_article_default_date: {@date}
      {
        \ClassError{abntexto-ufc}
          {Required~article~submission~date~was~not~set}
          {Use~the~standard~LaTeX~\string\date\{day~month~year\}~command~in~the~preamble.}
      }
      {}
  }

\cs_new_protected:Npn \ufc_article_title_block:
  {
    \ufc_article_require_metadata:n {autor}
    \ufc_article_require_metadata:n {titulo}
    \ufc_article_require_metadata:n {data-aprovacao}
    \ufc_article_require_submission_date:
    \par
    \begingroup
      \singlesp
      \centering
      \bfseries
      \ufc_title_text:\par
      \ufc_meta_if_blank:nF {variacao-titulo}
        {
          \vspace{\baselineskip}
          \MakeUppercase{\ufc_meta_use:n {variacao-titulo}}\par
        }
      \vspace{\baselineskip}
      \normalfont
      \ufc_meta_use:n {autor}\par
    \endgroup
    \vspace{\baselineskip}
    \begingroup
      \singlesp
      \raggedright
      Data~de~submissão:\space \cs_use:c {@date}\par
      Data~de~aprovação:\space \ufc_meta_use:n {data-aprovacao}\par
    \endgroup
    \vspace{\baselineskip}
  }

\cs_new_protected:Npn \ufc_article_summary:n #1
  {
    \par
    \ufc_pretextual_heading:n {Resumo}
    \begingroup
      \singlesp
      \setlength{\parindent}{0pt}
      \justifying\ufc_input_file:n {#1}
      \par
    \endgroup
    \vspace{\baselineskip}
  }

\cs_new_protected:Npn \ufc_article_abstract:n #1
  {
    \par
    \begingroup
      \selectlanguage{english}
      \singlesp
      \ufc_pretextual_heading:n {Abstract}
      \setlength{\parindent}{0pt}
      \justifying\ufc_input_file:n {#1}
      \par
    \endgroup
    \vspace{\baselineskip}
  }

\cs_new_protected:Npn \ufc_article_acknowledgments:n #1
  {
    \par\vspace{\baselineskip}
    \ufc_pretextual_heading:n {Agradecimentos}
    \begingroup
      \singlesp
      \justifying\ufc_input_file:n {#1}
      \par
    \endgroup
  }

\cs_new_protected:Npn \ufc_article_references:
  {
    \par\vspace{\baselineskip}
    \cs_if_exist:NT \phantomsection { \phantomsection }
    \addcontentsline{toc}{section}{\protect\toclabelbox{}Referências}
    \begingroup
      \singlesp
      \parindent=0pt
      \begin{center}
        \bfseries REFERÊNCIAS\par
      \end{center}
      \vspace{\baselineskip}
      \raggedright
      \setlength{\bibitemsep}{\baselineskip}
      \printbibliography[heading=none]
    \endgroup
  }

% Install document-command specializations only when the selected profile is an
% article. Every non-article document therefore keeps the certified command
% definitions exactly as they were before B2B.
\cs_new_protected:Npn \ufc_article_install_runtime:
  {
    \ufc_article_if:T
      {
        % Article pre-textual content uses the visible Arabic page style.
        \cs_set_eq:NN \pretextual \ufc_article_base_textual:

        % Primary sections and pre/post-textual article elements stay in a
        % continuous flow. layout.def remains the owner of break internals.
        \RenewDocumentCommand \ufcPrimarySectionBreak { } { }
        \RenewDocumentCommand \ufcPretextualBreak { } { }

        % A scientific article has no separate cover, title leaf, approval leaf,
        % or table of contents. The existing title-page call is reused as the
        % first-page article title/authorship/dates entry point.
        \RenewDocumentCommand \imprimircapa { } { }
        \RenewDocumentCommand \imprimirfolhaderosto { O{} }
          { \ufc_article_title_block: }
        \RenewDocumentCommand \imprimirfolhadeaprovacao { } { }
        \RenewDocumentCommand \imprimiragradecimentos { m }
          { \ufc_article_acknowledgments:n {##1} }
        \RenewDocumentCommand \imprimirresumo { m }
          { \ufc_article_summary:n {##1} }
        \RenewDocumentCommand \imprimirabstract { m }
          { \ufc_article_abstract:n {##1} }
        \RenewDocumentCommand \imprimirsumario { } { }
        \RenewDocumentCommand \imprimirreferencias { }
          { \ufc_article_references: }
      }
  }

% Run before ordinary begin-document hooks so the upstream automatic
% \pretextual call and UFC command hooks observe the article-specific surfaces.
\AddToHook{begindocument/before}{\ufc_article_install_runtime:}

% Run after ordinary begin-document hooks so the academic-document 1.5-spacing
% default cannot overwrite the article's required single-spacing policy.
\cs_new_protected:Npn \ufc_article_finalize_layout:
  {
    \ufc_article_if:T
      {
        \tl_gset:Nn \g_ufc_print_mode_tl { anverso }
        \ufc_layout_apply:
        \ufc_layout_one_sided:
        \setcounter{page}{1}
        \singlesp
        \setlength{\parskip}{0pt}
        \setlength{\parindent}{2cm}
      }
  }

\AddToHook{begindocument/end}{\ufc_article_finalize_layout:}

\ExplSyntaxOff

\endinput
