\ProvidesFile{ufctex/pretextuais-opcionais.def}[2026/08/19 UFC optional pre-textual elements]

% Normative mapping: docs/NORMAS.md.
% Complements pretextuais.def with the long-epigraph variant and errata.
% Residual pre-textual behavior is covered by the v2 preflight fixtures.

\ExplSyntaxOn

\cs_new_protected:Npn \ufc_epigraph_short:n #1
  {
    \clearpage
    \thispagestyle{empty}
    \vspace*{.45\textheight}
    \noindent\hspace*{8cm}%
    \begin{minipage}{\dimexpr\textwidth-8cm\relax}
      \ufc_input_file:n {#1}
      \ufc_meta_if_blank:nF {autor-epigrafe}
        { \par\raggedleft\ufc_meta_use:n {autor-epigrafe} }
    \end{minipage}
    \vfill
    \clearpage
  }

\cs_new_protected:Npn \ufc_epigraph_long:n #1
  {
    \clearpage
    \thispagestyle{empty}
    \vspace*{.45\textheight}
    \noindent\hspace*{4cm}%
    \begin{minipage}{\dimexpr\textwidth-4cm\relax}
      \fontsize{10}{12}\selectfont
      \singlesp
      \justifying
      \ufc_input_file:n {#1}
      \ufc_meta_if_blank:nF {autor-epigrafe}
        { \par\raggedleft\ufc_meta_use:n {autor-epigrafe} }
    \end{minipage}
    \vfill
    \clearpage
  }

\RenewDocumentCommand \imprimirepigrafe { O{curta} m }
  {
    \str_case:nnF {#1}
      {
        {curta} { \ufc_epigraph_short:n {#2} }
        {longa} { \ufc_epigraph_long:n {#2} }
      }
      {
        \ClassError{ufctex}
          {Invalid~epigraph~type~'#1'}
          {Use~\string\imprimirepigrafe[curta]~or~\string\imprimirepigrafe[longa].}
      }
  }

\NewDocumentCommand \imprimirerrata { m }
  {
    \clearpage
    \thispagestyle{empty}
    \ufc_pretextual_heading:n {Errata}
    \justifying
    \ufc_input_file:n {#1}
    \clearpage
  }

\ExplSyntaxOff

\endinput
