\ProvidesFile{ufctex/modulos.def}[2026/08/19 UFC optional modules]

\RequirePackage{etoolbox}

\ExplSyntaxOn

\tl_new:N \g_ufc_table_module_tl
\tl_new:N \g_ufc_code_module_tl
\tl_new:N \g_ufc_algorithm_module_tl
\tl_new:N \g_ufc_glossary_module_tl
\tl_new:N \g_ufc_index_module_tl
\bool_new:N \g_ufc_glossary_initialized_bool
\bool_new:N \g_ufc_index_initialized_bool

\keys_define:nn { ufc }
  {
    tabelas .choice:,
    tabelas / nativo .code:n =
      { \tl_gset:Nn \g_ufc_table_module_tl { nativo } },
    tabelas / tabularray .code:n =
      {
        \tl_gset:Nn \g_ufc_table_module_tl { tabularray }
        \RequirePackage{tabularray-abnt}
      },
    tabelas / tabularray-abnt .meta:n = { tabelas = tabularray },

    codigo .choice:,
    codigo / nenhum .code:n =
      { \tl_gset:Nn \g_ufc_code_module_tl { nenhum } },
    codigo / listings .code:n =
      {
        \tl_gset:Nn \g_ufc_code_module_tl { listings }
        \RequirePackage{listings}
      },
    codigo / minted .code:n =
      {
        \tl_gset:Nn \g_ufc_code_module_tl { minted }
        \RequirePackage{minted}
      },

    algoritmos .choice:,
    algoritmos / nenhum .code:n =
      { \tl_gset:Nn \g_ufc_algorithm_module_tl { nenhum } },
    algoritmos / algpseudocodex .code:n =
      {
        \tl_gset:Nn \g_ufc_algorithm_module_tl { algpseudocodex }
        \RequirePackage{algpseudocodex}
      },

    glossario .choice:,
    glossario / nenhum .code:n =
      { \tl_gset:Nn \g_ufc_glossary_module_tl { nenhum } },
    glossario / glossaries .code:n =
      {
        \tl_gset:Nn \g_ufc_glossary_module_tl { glossaries }
        \bool_if:NF \g_ufc_glossary_initialized_bool
          {
            \RequirePackage{glossaries-extra}
            \makeglossaries
            \ufcSetupGlossaryModule
            \bool_gset_true:N \g_ufc_glossary_initialized_bool
          }
      },
    glossario / glossaries-extra .meta:n = { glossario = glossaries },

    indice .choice:,
    indice / nenhum .code:n =
      { \tl_gset:Nn \g_ufc_index_module_tl { nenhum } },
    indice / imakeidx .code:n =
      {
        \tl_gset:Nn \g_ufc_index_module_tl { imakeidx }
        \bool_if:NF \g_ufc_index_initialized_bool
          {
            \RequirePackage{imakeidx}
            \makeindex[columns=1,title={ÍNDICE}]
            \ufcSetupIndexModule
            \bool_gset_true:N \g_ufc_index_initialized_bool
          }
      }
  }

\keys_set:nn { ufc }
  {
    tabelas = nativo,
    codigo = nenhum,
    algoritmos = nenhum,
    glossario = nenhum,
    indice = nenhum
  }

\NewExpandableDocumentCommand \ufcTableModule { }
  { \tl_use:N \g_ufc_table_module_tl }

\NewExpandableDocumentCommand \ufcCodeModule { }
  { \tl_use:N \g_ufc_code_module_tl }

\NewExpandableDocumentCommand \ufcAlgorithmModule { }
  { \tl_use:N \g_ufc_algorithm_module_tl }

\ExplSyntaxOff

\endinput
