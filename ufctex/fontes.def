\ProvidesFile{ufctex/fontes.def}[2026/08/20 UFC typography and font policy]

\RequirePackage{etoolbox}

\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage{newtxtext}
  \RequirePackage{newtxmath}
  \RequirePackage{tgheros}
\else
  \RequirePackage{fontspec}
  \RequirePackage{unicode-math}
  \setmathfont{TeX Gyre Termes Math}
\fi

\ExplSyntaxOn

\tl_new:N \g_ufc_font_family_tl
\bool_new:N \g_ufc_font_strict_bool
\bool_new:N \l_ufc_font_files_available_bool

\keys_define:nn { ufc }
  {
    fonte .choice:,
    fonte / times .code:n =
      { \tl_gset:Nn \g_ufc_font_family_tl { times } },
    fonte / arial .code:n =
      { \tl_gset:Nn \g_ufc_font_family_tl { arial } },

    fonte-estrita .choice:,
    fonte-estrita / sim .code:n =
      { \bool_gset_true:N \g_ufc_font_strict_bool },
    fonte-estrita / nao .code:n =
      { \bool_gset_false:N \g_ufc_font_strict_bool },
    fonte-estrita / true .meta:n = { fonte-estrita = sim },
    fonte-estrita / false .meta:n = { fonte-estrita = nao }
  }

\keys_set:nn { ufc }
  {
    fonte = times,
    fonte-estrita = nao
  }

\cs_new_protected:Npn \ufc_font_check_files:n #1
  {
    \bool_set_true:N \l_ufc_font_files_available_bool
    \clist_map_inline:nn {#1}
      {
        \file_if_exist:nF {##1}
          { \bool_set_false:N \l_ufc_font_files_available_bool }
      }
  }

\cs_new_protected:Npn \ufc_font_pdftex_times:
  {
    \ufc_font_check_files:n
      {
        t1times-ttf.fd,
        winfonts.map,
        times.ttf,
        timesbd.ttf,
        timesi.ttf,
        timesbi.ttf
      }
    \bool_if:NTF \l_ufc_font_files_available_bool
      {
        \renewcommand{\rmdefault}{times-ttf}
        \renewcommand{\familydefault}{\rmdefault}
        \ClassInfo{ufctex}{Using literal Times New Roman with pdfLaTeX}
      }
      {
        \bool_if:NTF \g_ufc_font_strict_bool
          {
            \ClassError{ufctex}
              {Times New Roman literal is not available to pdfLaTeX}
              {Install the Microsoft font and winfonts support, or use LuaLaTeX.}
          }
          {
            \renewcommand{\rmdefault}{ntxtlf}
            \renewcommand{\familydefault}{\rmdefault}
            \ClassInfo{ufctex}{Times New Roman not available to pdfLaTeX; using NewTX compatibility fallback}
          }
      }
  }

\cs_new_protected:Npn \ufc_font_pdftex_arial:
  {
    \ufc_font_check_files:n
      {
        t1arial.fd,
        winfonts.map,
        arial.ttf,
        arialbd.ttf,
        ariali.ttf,
        arialbi.ttf
      }
    \bool_if:NTF \l_ufc_font_files_available_bool
      {
        \renewcommand{\sfdefault}{arial}
        \renewcommand{\familydefault}{\sfdefault}
        \ClassInfo{ufctex}{Using literal Arial with pdfLaTeX}
      }
      {
        \bool_if:NTF \g_ufc_font_strict_bool
          {
            \ClassError{ufctex}
              {Arial literal is not available to pdfLaTeX}
              {Install the Microsoft font and winfonts support, or use LuaLaTeX.}
          }
          {
            \renewcommand{\sfdefault}{qhv}
            \renewcommand{\familydefault}{\sfdefault}
            \ClassInfo{ufctex}{Arial not available to pdfLaTeX; using TeX Gyre Heros compatibility fallback}
          }
      }
  }

\cs_new_protected:Npn \ufc_font_luatex_times:
  {
    \IfFontExistsTF{Times New Roman}
      {
        \setmainfont{Times New Roman}
        \ClassInfo{ufctex}{Using literal Times New Roman with LuaLaTeX}
      }
      {
        \bool_if:NTF \g_ufc_font_strict_bool
          {
            \ClassError{ufctex}
              {Times New Roman not found}
              {Install Times New Roman or set fonte-estrita=nao.}
          }
          {
            \ClassWarningNoLine{ufctex}{Times New Roman not found; using TeX Gyre Termes}
            \setmainfont{TeX Gyre Termes}
          }
      }
  }

\cs_new_protected:Npn \ufc_font_luatex_arial:
  {
    \IfFontExistsTF{Arial}
      {
        \setmainfont{Arial}
        \ClassInfo{ufctex}{Using literal Arial with LuaLaTeX}
      }
      {
        \bool_if:NTF \g_ufc_font_strict_bool
          {
            \ClassError{ufctex}
              {Arial not found}
              {Install Arial or set fonte-estrita=nao.}
          }
          {
            \ClassWarningNoLine{ufctex}{Arial not found; using TeX Gyre Heros}
            \setmainfont{TeX Gyre Heros}
          }
      }
  }

\cs_new_protected:Npn \ufc_font_apply:
  {
    \ifPDFTeX
      \str_case:Vn \g_ufc_font_family_tl
        {
          { times } { \ufc_font_pdftex_times: }
          { arial } { \ufc_font_pdftex_arial: }
        }
    \else
      \str_case:Vn \g_ufc_font_family_tl
        {
          { times } { \ufc_font_luatex_times: }
          { arial } { \ufc_font_luatex_arial: }
        }
    \fi
  }

\AtEndPreamble{\ufc_font_apply:}

\ExplSyntaxOff

\endinput
