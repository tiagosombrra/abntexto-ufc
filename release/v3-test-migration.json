  "source_rewrite_requirements": [
    "all test documents use the canonical v3 English setup/API surface",
    "all test code comments and diagnostics are English",
    "Portuguese text is retained only when it is document payload or expected rendered output",
    "test references to normativa/ are rewritten to standards/",
    "test references to root main.tex/frontmatter/chapters/backmatter/figures are rewritten for template/ repository layout",
    "tests that validate distribution use the flattened user-bundle layout rather than the repository template layout",
    "no active test asserts Portuguese API compatibility"
  ],
  "orchestration": {
    "entrypoint": "tests/run.py",
    "action": "retain-and-rewrite",
    "requirements": [
      "semantic test IDs without v2/N-phase names",
      "dependency graph preserved where behavior remains applicable",
      "no redundant recompilation when an artifact can be safely reused",
      "release mode remains a strict superset of PR mode",
      "failure output identifies semantic gate and command"
    ]
  },
  "workflows": {
    ".github/workflows/standards.yml": {
      "from": ".github/workflows/normative-source.yml",
      "responsibility": "standards source/authority/contracts",
      "required_path_updates": ["normativa/** -> standards/**", "renamed semantic checkers"]
    },
    ".github/workflows/latex-preflight.yml": {
      "responsibility": "cross-platform LaTeX regression and Gate T orchestration",
      "v2_frozen_blob_status": "historical-only",
      "action": "rewrite for v3 semantic paths and tests"
    },
    ".github/workflows/distribution.yml": {
      "responsibility": "release bundles, deterministic archives and distribution validation",
      "action": "rewrite for template/ repository source and flattened user bundles"
    },
    ".github/workflows/reference-preview.yml": {
      "responsibility": "reference document preview",
      "action": "rewrite for template/main.tex"
    },
    ".github/workflows/reference-validation.yml": {
      "responsibility": "pending value review",
      "action": "retain through restructuring; prove unique value or remove in V3-H1"
    },
    ".github/workflows/validator-pages.yml": {
      "responsibility": "validator static deployment",
      "action": "retain and audit engineering-language compliance"
    }
  },
  "documentation": {
    "active_authorities": [
      "docs/ROADMAP-V3.0.0.md",
