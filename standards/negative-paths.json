{
  "schema_version": 2,
  "purpose": "Validate that current normative validators reject isolated controlled violations for the intended predicate rather than through incidental compile or runtime failures.",
  "policy": {
    "positive_baseline_required": true,
    "compile_failure_counts_as_rejection": false,
    "target_rejection_must_be_nonzero": true,
    "failed_rule_evidence_required": true,
    "mutations_are_temporary": true,
    "normative_contract_changed": false,
    "locator_policy_changed": false,
    "validator_tolerances_changed": false,
    "proof_state_changed": false
  },
  "mechanism_inventory": [
    {
      "id": "final-pdf-geometry",
      "state": "represented",
      "case_ids": ["page-margins-right"]
    },
    {
      "id": "text-typography-extraction",
      "state": "represented",
      "case_ids": ["body-font-size"]
    },
    {
      "id": "citation-quotation-presentation",
      "state": "represented",
      "case_ids": ["short-direct-citation-quotes"]
    },
    {
      "id": "vector-rule-geometry",
      "state": "represented",
      "case_ids": ["ibge-table-open-sides"]
    },
    {
      "id": "configuration-strict-rejection",
      "state": "represented",
      "evidence_paths": [
        "tests/integration/font-config.sh",
        "tests/integration/pdf-validator.sh",
        "tests/checks/normative_configuration.py",
        "tests/integration/negative-paths.sh"
      ]
    },
    {
      "id": "semantic-structural-observers",
      "state": "represented",
      "case_ids": ["project-required-resources"],
      "evidence_paths": ["tests/checks/normative_research_project_structure.py"]
    },
    {
      "id": "pdf-archival-validation",
      "state": "represented",
      "evidence_paths": [
        "tests/integration/pdfa.sh",
        "tests/integration/profile-pdfa.sh",
        "tests/checks/normative_pdfa.py"
      ]
    }
  ],
  "cases": [
    {
      "id": "page-margins-right",
      "family": "final-pdf-geometry",
      "fixture": "tests/documents/mainmatter-page-margins-test.tex",
      "positive_gate": ["sh", "tests/integration/page-margins-evidence.sh"],
      "mutation": {
        "kind": "replace_once",
        "anchor": "\\textual\n\n\\ufctextareaframe",
        "content": "\\textual\n\\newgeometry{twoside=true,inner=3cm,outer=4cm,top=3cm,bottom=2cm}\n\n\\ufctextareaframe"
      },
      "compile": {"engine": "pdflatex", "passes": 2},
      "validator": [
        "python3",
        "tests/checks/normative_page_margins.py",
        "{pdf}",
        "--json",
        "{evidence_json}"
      ],
      "expected_rule_id": "margin.recto.right"
    },
    {
      "id": "body-font-size",
      "family": "text-typography-extraction",
      "fixture": "tests/documents/mainmatter-typography-test.tex",
      "positive_gate": ["sh", "tests/integration/typography-evidence.sh"],
      "mutation": {
        "kind": "replace_once",
        "anchor": "\\noindent UFCNSevenBodyAlpha\\\\\n",
        "content": "\\noindent {\\fontsize{14}{16}\\selectfont UFCNSevenBodyAlpha}\\\\\n"
      },
      "compile": {"engine": "pdflatex", "passes": 2},
      "validator": [
        "python3",
        "tests/checks/normative_typography.py",
        "{pdf}",
        "--json",
        "{evidence_json}"
      ],
      "expected_rule_id": "font.size.body"
    },
    {
      "id": "short-direct-citation-quotes",
      "family": "citation-quotation-presentation",
      "fixture": "tests/documents/mainmatter-short-direct-citation-test.tex",
      "positive_gate": ["sh", "tests/integration/short-direct-citation-evidence.sh"],
      "mutation": {
        "kind": "insert_before",
        "anchor": "\\begin{document}",
        "content": "\\renewcommand{\\enquote}[1]{#1}\n"
      },
      "compile": {"engine": "pdflatex", "passes": 2},
      "validator": [
        "python3",
        "tests/checks/normative_short_direct_citation.py",
        "{pdf}",
        "--json",
        "{evidence_json}"
      ],
      "expected_rule_id": "citation.direct-short.quotation-marks"
    },
    {
      "id": "ibge-table-open-sides",
      "family": "vector-rule-geometry",
      "fixture": "tests/documents/table-ibge-vector-final-pdf.tex",
      "positive_gate": ["sh", "tests/integration/table-ibge-vector-evidence.sh"],
      "mutation": {
        "kind": "replace_once",
        "anchor": "colspec={X[l] X[r]}",
        "content": "colspec={|X[l]| X[r]|}"
      },
      "compile": {"engine": "pdflatex", "passes": 2},
      "validator": [
        "python3",
        "tests/checks/normative_table_ibge_vector.py",
        "{pdf}",
        "--json",
        "{evidence_json}"
      ],
      "expected_rule_id": "table.ibge.open-sides"
    },
    {
      "id": "project-required-resources",
      "family": "semantic-structural-observers",
      "fixture": "tests/documents/research-project-15287.tex",
      "positive_gate": ["sh", "tests/integration/research-project.sh"],
      "mutation": {
        "kind": "replace_once",
        "anchor": "\\section{Recursos}\nRecursos necessários à execução da pesquisa.",
        "content": "\\section{Infraestrutura}\nInfraestrutura necessária à execução da pesquisa."
      },
      "compile": {"engine": "pdflatex", "passes": 3, "biber_after_pass": 1},
      "validator": [
        "python3",
        "tests/checks/normative_research_project_structure.py",
        "{pdf}",
        "--json",
        "{evidence_json}",
        "--enforce"
      ],
      "expected_rule_id": "project.textual.required-sections"
    }
  ]
}
