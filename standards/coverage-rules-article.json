{
  "schema_version": 1,
  "reviewed_at": "2026-08-28",
  "phase": "N15-B2A",
  "purpose": "Source-backed scientific-article contract. B2-A promotes article requirements and recommendations without changing LaTeX runtime behavior; implementation evidence is deferred to N15-B2B/N15-B2C.",
  "rules": [
    {
      "id": "article.structure.required",
      "category": "article",
      "requirement": "O artigo científico contém os elementos obrigatórios e preserva a ordem estrutural de elementos pré-textuais, textuais e pós-textuais.",
      "locator": "Guia UFC de Artigo 2022, 2.1, p. 7",
      "normativity": "required-for-article-profile",
      "kind": "document-structure",
      "values": {
        "required": ["title-text-language", "authorship", "abstract-text-language", "keywords-text-language", "submission-date", "approval-date", "introduction", "development", "final-considerations", "references"],
        "optional": ["title-other-language", "abstract-other-language", "keywords-other-language", "identification-availability", "glossary", "appendix", "annex", "acknowledgements"],
        "ordered_groups": ["pretextual", "textual", "posttextual"]
      },
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "technical",
      "sources": ["abnt-nbr-6022-2018", "ufc-guia-artigos-2022"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.title.presentation",
      "category": "article-pretextual",
      "requirement": "O título no idioma do texto é obrigatório, aparece na primeira página, inicia na margem superior e usa centralização, maiúsculas, negrito, tamanho 12 e espaço simples; o subtítulo, quando houver, é separado por dois pontos ou diferenciado tipograficamente.",
      "locator": "Guia UFC de Artigo 2022, 2.2.1.1, p. 8",
      "normativity": "institutional-requirement",
      "kind": "article-title",
      "values": {"required": true, "first_page": true, "alignment": "center", "uppercase": true, "bold": true, "font_pt": 12, "line_spacing": 1.0, "subtitle_separator": "colon-or-typographic-differentiation"},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.authorship.presentation",
      "category": "article-pretextual",
      "requirement": "A autoria é obrigatória, usa ordem direta dos nomes, aparece após o título, em tamanho 12 e espaço simples; currículo sucinto, vinculação e contato são apresentados em nota de rodapé com chamada própria.",
      "locator": "Guia UFC de Artigo 2022, 2.2.1.3, pp. 9-10",
      "normativity": "institutional-requirement",
      "kind": "article-authorship",
      "values": {"required": true, "name_order": "direct", "position": "after-title", "font_pt": 12, "line_spacing": 1.0, "author-note": {"required": true, "contents": ["short-curriculum", "corporate-affiliation", "contact-address"], "citation-system": "independent"}},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.abstract.presentation",
      "category": "article-pretextual",
      "requirement": "O resumo no idioma do texto é obrigatório e acompanhado de palavras-chave; o cabeçalho RESUMO é centralizado, em maiúsculas, negrito, tamanho 12 e espaço simples, e o texto é tamanho 12, justificado, em espaço simples e sem recuo de primeira linha.",
      "locator": "Guia UFC de Artigo 2022, 2.2.1.4, pp. 10-11",
      "normativity": "institutional-requirement-compatible-with-current-abnt",
      "kind": "article-abstract",
      "values": {"required": true, "keywords_required": true, "heading": "RESUMO", "heading_centered": true, "heading_uppercase": true, "heading_bold": true, "font_pt": 12, "line_spacing": 1.0, "alignment": "justified", "first_line_indent_mm": 0, "keyword_separator": "semicolon", "keyword_terminal_punctuation": "period"},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022", "abnt-nbr-6028-2021"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.abstract.length.recommended",
      "category": "article-pretextual",
      "requirement": "Para o resumo do artigo, a UFC recomenda 150 a 250 palavras e convém indicar pelo menos três palavras-chave; esses limites não são requisitos duros do perfil.",
      "locator": "Guia UFC de Artigo 2022, 2.2.1.4, p. 10",
      "normativity": "recommendation",
      "kind": "recommended-range",
      "values": {"words_min": 150, "words_max": 250, "keywords_min": 3, "enforcement": "advisory"},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.dates.required",
      "category": "article-pretextual",
      "requirement": "As datas de submissão e aprovação são obrigatórias e informam dia, mês e ano, precedidas das respectivas expressões institucionais.",
      "locator": "Guia UFC de Artigo 2022, 2.2.1.6, pp. 12-13",
      "normativity": "institutional-requirement",
      "kind": "article-dates",
      "values": {"submission_required": true, "approval_required": true, "granularity": ["day", "month", "year"], "labels": ["Data de submissão:", "Data de aprovação:"], "font_pt": 12, "line_spacing": 1.0, "alignment": "left"},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.textual.required-sections",
      "category": "article-textual",
      "requirement": "Os elementos textuais obrigatórios são introdução, desenvolvimento e considerações finais e são numerados segundo a NBR 6024 vigente.",
      "locator": "Guia UFC de Artigo 2022, 2.2.2-2.2.2.3, pp. 16-17",
      "normativity": "institutional-requirement-compatible-with-current-abnt",
      "kind": "document-structure",
      "values": {"required": ["introduction", "development", "final-considerations"], "numbered": true, "numbering_standard": "ABNT NBR 6024:2012"},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022", "abnt-nbr-6024-2012", "abnt-nbr-6022-2018"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.textual.typography",
      "category": "article-textual",
      "requirement": "Todos os elementos textuais usam fonte tamanho 12, texto justificado, recuo de 2 cm na primeira linha e espaço simples entre linhas.",
      "locator": "Guia UFC de Artigo 2022, 2.2.2, p. 16",
      "normativity": "institutional-requirement",
      "kind": "paragraph",
      "values": {"font_pt": 12, "alignment": "justified", "first_line_indent_mm": 20, "line_spacing": 1.0},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.references.required-placement",
      "category": "article-posttextual",
      "requirement": "As referências são obrigatórias, seguem a edição técnica vigente da NBR 6023 e iniciam uma linha após as considerações finais; o título REFERÊNCIAS é centralizado, em maiúsculas, negrito, tamanho 12 e espaço simples.",
      "locator": "Guia UFC de Artigo 2022, 2.2.3.1, p. 17",
      "normativity": "institutional-requirement-compatible-with-current-abnt",
      "kind": "article-references",
      "values": {"required": true, "position": "one-line-after-final-considerations", "heading": "REFERÊNCIAS", "heading_centered": true, "heading_uppercase": true, "heading_bold": true, "font_pt": 12, "line_spacing": 1.0, "current_reference_standard": "ABNT NBR 6023:2025"},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022", "abnt-nbr-6023-2025"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.page.margins",
      "category": "article-layout",
      "requirement": "O artigo usa papel A4 e margens esquerda e superior de 3 cm e direita e inferior de 2 cm.",
      "locator": "Guia UFC de Artigo 2022, 2.3.1-2.3.2, pp. 22-23",
      "normativity": "institutional-requirement",
      "kind": "page-layout",
      "values": {"paper": "A4", "left_mm": 30, "top_mm": 30, "right_mm": 20, "bottom_mm": 20},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.font.family.recommended",
      "category": "article-typography",
      "requirement": "Para o artigo como um todo, a UFC recomenda Arial ou Times New Roman em tamanho 12; a família tipográfica é orientação, não requisito duro.",
      "locator": "Guia UFC de Artigo 2022, 2.3.1(c), p. 22",
      "normativity": "recommendation",
      "kind": "font-recommendation",
      "values": {"allowed": ["Arial", "Times New Roman"], "font_pt": 12, "enforcement": "advisory"},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.pagination",
      "category": "article-layout",
      "requirement": "Todas as folhas do artigo, desde a primeira, são numeradas sequencialmente em algarismos arábicos no canto superior direito, a 2 cm das bordas superior e direita; apêndices e anexos continuam a numeração.",
      "locator": "Guia UFC de Artigo 2022, 2.3.4, p. 26",
      "normativity": "institutional-requirement",
      "kind": "pagination",
      "values": {"start": "first-page", "numbering": "arabic", "position": "upper-right", "top_offset_mm": 20, "right_offset_mm": 20, "appendix_annex_continuous": true},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022"],
      "applicability": {"profiles": ["artigo"]}
    },
    {
      "id": "article.sections.continuous",
      "category": "article-textual",
      "requirement": "As seções do artigo seguem fluxo contínuo, sem reiniciar seção em página distinta; seções textuais são numeradas e os títulos não numerados previstos pelo guia são centralizados, em maiúsculas e negrito.",
      "locator": "Guia UFC de Artigo 2022, 2.3.5.1, pp. 26-28",
      "normativity": "institutional-requirement-compatible-with-current-abnt",
      "kind": "section-flow",
      "values": {"primary_starts_new_page": false, "blank_simple_line_before_after": true, "numbered_scope": "textual-elements-only", "unnumbered": ["abstract-text-language", "abstract-other-language", "explanatory-notes", "references", "glossary", "appendix", "annex", "acknowledgements"], "unnumbered_heading": {"centered": true, "uppercase": true, "bold": true}},
      "validation": {"mode": "automatic-partial", "checks": ["validator-source"]},
      "scope": "institutional",
      "sources": ["ufc-guia-artigos-2022", "abnt-nbr-6024-2012"],
      "applicability": {"profiles": ["artigo"]}
    }
  ]
}
