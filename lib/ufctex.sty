% Determina o tipo do documento apresentado.
% Modos suportados:
%   tccgraduacao       - Trabalho de Conclusão de Curso de Graduação
%   tccespecializacao  - Trabalho de Conclusão de Curso de Especialização
%   dissertacao        - Dissertação de Mestrado
%   tese               - Tese de Doutorado
%   projeto            - Projeto de pesquisa identificado
%   projetoanonimizado - Anonymized research project
%
% The anonymized mode is deliberately restricted to research projects. It removes
% author/advisor identification from visible content and PDF metadata.
% Legacy alias `projetocego` remains accepted for backward compatibility.
\provideboolean{ufctex@ehtccgraduacao}
\provideboolean{ufctex@ehtccespecializacao}
\provideboolean{ufctex@ehdissertacao}
\provideboolean{ufctex@ehtese}
\provideboolean{ufctex@ehprojeto}
\provideboolean{ufctex@ehprojetoanonimizado}
\provideboolean{ufctex@fichacatalografica}
\provideboolean{ufctex@brasaoemprojeto}

\setboolean{ufctex@ehtccgraduacao}{true}
\setboolean{ufctex@ehtccespecializacao}{false}
\setboolean{ufctex@ehdissertacao}{false}
\setboolean{ufctex@ehtese}{false}
\setboolean{ufctex@ehprojeto}{false}
\setboolean{ufctex@ehprojetoanonimizado}{false}
\setboolean{ufctex@fichacatalografica}{false}
\setboolean{ufctex@brasaoemprojeto}{true}

% Interface moderna baseada na camada de programação LaTeX3, que integra o
% kernel do LaTeX atual. Os booleans históricos permanecem como estado interno
% para preservar integralmente as macros antigas deste template.
\ExplSyntaxOn

\cs_new_protected:Npn \ufc_set_document_type:n #1
  {
    \setboolean{ufctex@ehtccgraduacao}{false}
    \setboolean{ufctex@ehtccespecializacao}{false}
    \setboolean{ufctex@ehdissertacao}{false}
    \setboolean{ufctex@ehtese}{false}
    \setboolean{ufctex@ehprojeto}{false}
    \setboolean{ufctex@ehprojetoanonimizado}{false}
    \str_case:nnF {#1}
      {
        {tccgraduacao}
          {\setboolean{ufctex@ehtccgraduacao}{true}}
        {tccespecializacao}
          {\setboolean{ufctex@ehtccespecializacao}{true}}
        {dissertacao}
          {\setboolean{ufctex@ehdissertacao}{true}}
        {tese}
          {\setboolean{ufctex@ehtese}{true}}
        {projeto}
          {\setboolean{ufctex@ehprojeto}{true}}
        {projetoanonimizado}
          {
            \setboolean{ufctex@ehprojeto}{true}
            \setboolean{ufctex@ehprojetoanonimizado}{true}
          }
        {projetocego}
          {
            \PackageWarning{ufctex}
              {Mode~'projetocego'~is~deprecated;~use~'projetoanonimizado'}
            \setboolean{ufctex@ehprojeto}{true}
            \setboolean{ufctex@ehprojetoanonimizado}{true}
          }
      }
      {
        \PackageWarning{ufctex}
          {Tipo~de~documento~'#1'~desconhecido.~Usando~tccgraduacao}
        \setboolean{ufctex@ehtccgraduacao}{true}
      }
  }

\NewDocumentCommand{\trabalhoacademico}{m}
  {\ufc_set_document_type:n {#1}}

% --------------------------------------------------------------------------
% Módulos opcionais
% --------------------------------------------------------------------------
\cs_new_protected:Npn \ufc_load_algpseudocodex:
  {
    \@ifpackageloaded{algorithm}{}{\RequirePackage{algorithm}}
    \@ifpackageloaded{algpseudocodex}{}{\RequirePackage{algpseudocodex}}
    \floatname{algorithm}{Algoritmo}
    \renewcommand{\listalgorithmname}{Lista~de~Algoritmos}
    \algrenewcommand\algorithmicrequire{\textbf{Entrada:}}
    \algrenewcommand\algorithmicensure{\textbf{Saída:}}
    \algrenewcommand\algorithmicfor{\textbf{para}}
    \algrenewcommand\algorithmicwhile{\textbf{enquanto}}
    \algrenewcommand\algorithmicif{\textbf{se}}
    \algrenewcommand\algorithmicthen{\textbf{faça}}
    \algrenewcommand\algorithmicelse{\textbf{senão}}
  }

\cs_new_protected:Npn \ufc_load_algorithm_two_e:
  {
    \@ifpackageloaded{algorithm2e}{}
      {
        \PassOptionsToPackage{portuguese,ruled,lined}{algorithm2e}
        \RequirePackage{algorithm2e}
      }
    \SetKwFor{Para}{para}{faça}{fim~para}
    \SetKwBlock{Inicio}{início}{fim}
    \renewcommand{\listalgorithmcfname}{Lista~de~Algoritmos}
  }

\cs_new_protected:Npn \ufc_load_minted:
  {\@ifpackageloaded{minted}{}{\RequirePackage{minted}}}

\cs_new_protected:Npn \ufc_load_graphics_stack:
  {
    \@ifpackageloaded{tikz}{}{\RequirePackage{tikz}}
    \@ifpackageloaded{pgfplots}{}{\RequirePackage{pgfplots}}
    \@ifpackageloaded{pgfplotstable}{}{\RequirePackage{pgfplotstable}}
    \pgfplotsset{compat=1.18}
  }

\cs_new_protected:Npn \ufc_load_tcolorbox:
  {
    \@ifpackageloaded{tcolorbox}{}
      {\RequirePackage[most]{tcolorbox}}
  }

\cs_new_protected:Npn \ufc_load_thmtools:
  {\@ifpackageloaded{thmtools}{}{\RequirePackage{thmtools}}}

