\newcommand{\imprimirepigrafe}[2][curta]{
	\ifthenelse{\boolean{ufctex@ehqualificacao}}{}{
		\vspace*{\fill}
		\vfill
		\ifthenelse{\equal{#1}{longa}}{%
			% UFC guide: epigraphs longer than three lines follow long-quotation
			% presentation: 4 cm indent, reduced font, single spacing and no quotes.
			\noindent\hspace*{4cm}%
			\begin{minipage}{\dimexpr\textwidth-4cm\relax}
				\footnotesize\SingleSpacing
				\input{#2}
				\raggedleft{(\imprimirautordaepigrafe) \par}
			\end{minipage}%
		}{%
			% UFC guide: epigraphs up to three lines start 8 cm from the left
			% text margin, use 12 pt and 1.5 spacing. The source file should keep
			% quotation marks when appropriate.
			\noindent\hspace*{8cm}%
			\begin{minipage}{\dimexpr\textwidth-8cm\relax}
				\normalsize\OnehalfSpacing
				\input{#2}
				\raggedleft{(\imprimirautordaepigrafe) \par}
			\end{minipage}%
		}%
		\pagebreak
	}
}


