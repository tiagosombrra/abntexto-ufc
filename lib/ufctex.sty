% A nomenclatura e os comandos de algoritmos são configurados pelo módulo
% selecionado em \ufcsetup; não há dependência global de algorithm2e.

% Numeracao da tabela comeca em 1
\setcounter{table}{0}

% ABNT NBR 14724 / UFC guides and IBGE tabular rules: figures, tables and frames.
% Guias UFC: identificação acima e fonte abaixo; legenda/fonte em tamanho
% reduzido e espaço simples. O corpo da tabela/figura permanece no tamanho
% normal do texto. O uso direto de \IBGEtab fica preservado como legado, mas
% não é usado pelos helpers abaixo porque pode reduzir todo o objeto.
\newsavebox{\ufc@objectbox}
\newlength{\ufc@objectwidth}
\newcommand{\ufc@object}[3]{%
    \ufcIfBlankTF{#3}{%
        \PackageWarning{ufctex}{Fonte de figura/tabela/quadro vazia; informe a origem do objeto}%
    }{}%
    \sbox{\ufc@objectbox}{\ignorespaces#2\unskip}%
    \setlength{\ufc@objectwidth}{\wd\ufc@objectbox}%
    \ifdim\ufc@objectwidth>\linewidth
        \setlength{\ufc@objectwidth}{\linewidth}%
    \fi
    \par\noindent
    \makebox[\linewidth][c]{%
        \begin{minipage}{\ufc@objectwidth}%
            #1%
            \centering\usebox{\ufc@objectbox}\par
            \raggedright #3%
        \end{minipage}%
    }%
    \par
}
\newcommand{\UFCfig}[3]{\ufc@object{#1}{#2}{#3}}
\newcommand{\UFCtab}[3]{\ufc@object{#1}{#2}{#3}}
\newcommand{\UFCqua}[3]{\ufc@object{#1}{#2}{#3}}

% Helper opcional para imagens responsivas: preserva proporção e evita que a
% imagem ultrapasse a largura/altura útil da página.
\newcommand{\UFCincludegraphics}[2][]{%
    \adjustbox{max width=\linewidth,max totalheight=.78\textheight}{%
        \includegraphics[#1]{#2}%
    }%
}

