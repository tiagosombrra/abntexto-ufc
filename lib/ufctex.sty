% Condicionais públicas para personalizar conteúdo sem acessar variáveis internas.
\newcommand{\seprojeto}[2]{%
    \ifthenelse{\boolean{ufctex@ehprojeto}}{#1}{#2}%
}
\newcommand{\seprojetoanonimizado}[2]{%
    \ifthenelse{\boolean{ufctex@ehprojetoanonimizado}}{#1}{#2}%
}
% Legacy public alias.
\newcommand{\seprojetocego}[2]{\seprojetoanonimizado{#1}{#2}}

% A ficha catalográfica visual tornou-se facultativa nos trabalhos acadêmicos
% conforme orientação atual do Sistema de Bibliotecas da UFC. O arquivo legado
% continua no pacote e pode ser habilitado explicitamente quando desejado.
\newcommand{\incluirfichacatalografica}[1]{%
    \ifthenelse{\equal{#1}{sim}}{%
        \setboolean{ufctex@fichacatalografica}{true}%
    }{%
        \setboolean{ufctex@fichacatalografica}{false}%
    }%
}

% UFC project guide: the sample project cover displays the UFC coat of arms, while
% the textual element list does not explicitly make it mandatory. The template
% therefore keeps it enabled by default and allows a call-specific override.
\newcommand{\brasaoemprojeto}[1]{%
    \ifthenelse{\equal{#1}{sim}}{%
        \setboolean{ufctex@brasaoemprojeto}{true}%
    }{%
        \setboolean{ufctex@brasaoemprojeto}{false}%
    }%
}

\AtBeginDocument{ %
    % In anonymized project mode, the author is also removed from PDF metadata.
    \seprojetoanonimizado{%
        \hypersetup{%
            pdftitle={\imprimirtitulo},%
            pdfauthor={},%
            pdfsubject={\imprimirtipoprojeto},%
            pdfkeywords={}%
        }%
    }{%
        \seprojeto{%
            \hypersetup{%
