% The nature statement avoids grammatical dependency on the type/gender of the
% academic unit (Centro, Faculdade, Instituto or Campus), keeping the template
% reusable across UFC units. Unit names remain available on the cover.
\newcommand{\preambulotccgraduacao}{
    Trabalho de Conclusão de Curso apresentado ao Curso de Graduação em \imprimirgraduacaoem\ da \imprimiries, como requisito parcial à obtenção do grau de \imprimirhabilitacao\ em \imprimirgraduacaoem. \\
}

\newcommand{\preambulotccespecializacao}{
    Trabalho de Conclusão de Curso apresentado ao Curso de Especialização em \imprimirespecializacaoem\ da \imprimiries, como requisito parcial à obtenção do título de especialista em \imprimirespecializacaoem. \\
}

\newcommand{\preambulodissertacao}{
    Dissertação apresentada ao \imprimirprogramamestrado\ da \imprimiries, como requisito parcial à obtenção do título de mestre em \imprimirmestreem. Área de Concentração: \imprimirareadeconcentracaomestrado. \\
}

\newcommand{\preambulotese}{
    Tese apresentada ao \imprimirprogramadoutorado\ da \imprimiries, como requisito parcial à obtenção do título de doutor em \imprimirdoutorem. Área de Concentração: \imprimirareadeconcentracaodoutorado. \\
}

% Project nature statement. Use an exact user-provided sentence when required by a
% course/program/call; otherwise fall back to a generic sentence.
\newcommand{\preambuloprojeto}{%
    \ifthenelse{\equal{\imprimirnaturezaprojeto}{}}{%
        \imprimirtipoprojeto\ apresentado à \imprimirentidadesubmissao.
    }{%
        \imprimirnaturezaprojeto
    }%
}

\preambulo{
    \ifthenelse{\boolean{ufctex@ehprojeto}}{%
        \preambuloprojeto
    }{%
        \ifthenelse{\boolean{ufctex@ehqualificacao}}{%
            Proposta de qualificação apresentada ao Curso de \imprimirmestrado\ da \imprimiries\ (\imprimiriessigla) como requisito parcial para a defesa de dissertação.
        }{%
            \ifthenelse{\boolean{ufctex@ehdissertacao}}{%
                \preambulodissertacao
            }{\ifthenelse{\boolean{ufctex@ehtese}}{%
                \preambulotese
            }{\ifthenelse{\boolean{ufctex@ehtccgraduacao}}{%
                \preambulotccgraduacao
            }{%
                \preambulotccespecializacao
            }}}
        }
    }
}

